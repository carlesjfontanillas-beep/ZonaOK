{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZonaOK – Jugadors master v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "seasonId",
    "players",
    "memberships"
  ],
  "properties": {
    "schema": {
      "const": "zonaok-jugadors-v1"
    },
    "source": {
      "const": "FECAPA"
    },
    "seasonId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "coverageVerified": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "unverified_empty",
        "candidate_only"
      ]
    },
    "players": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "playerId",
          "name",
          "firstSeenAt",
          "lastSeenAt",
          "nameVariants"
        ],
        "properties": {
          "playerId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "firstSeenAt": {
            "type": "string",
            "minLength": 1
          },
          "lastSeenAt": {
            "type": "string",
            "minLength": 1
          },
          "nameVariants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "memberships": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*\\|[1-9][0-9]*\\|[1-9][0-9]*\\|[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "playerId",
          "leagueId",
          "teamFilterId",
          "seasonId",
          "teamName",
          "teamId",
          "clubId",
          "clubName",
          "firstSeenAt",
          "lastSeenAt",
          "profileUrl"
        ],
        "properties": {
          "playerId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "leagueId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "teamFilterId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "seasonId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "teamName": {
            "type": [
              "string",
              "null"
            ]
          },
          "teamId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "clubId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "clubName": {
            "type": [
              "string",
              "null"
            ]
          },
          "firstSeenAt": {
            "type": "string",
            "minLength": 1
          },
          "lastSeenAt": {
            "type": "string",
            "minLength": 1
          },
          "profileUrl": {
            "type": "string",
            "pattern": "^https://www\\.hoqueipatins\\.fecapa\\.cat/\\?"
          },
          "sports": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 0
              },
              "played": {
                "type": "integer",
                "minimum": 0
              },
              "goals": {
                "type": "integer",
                "minimum": 0
              },
              "yellowCards": {
                "type": "integer",
                "minimum": 0
              },
              "redCards": {
                "type": "integer",
                "minimum": 0
              },
              "blueCards": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
